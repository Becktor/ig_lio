import os
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument
from launch_ros.actions import Node
from launch.actions import IncludeLaunchDescription
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration
from launch.actions import OpaqueFunction
import yaml

def load_yaml(package_name, file_name):
    """Helper function to load YAML configuration files."""
    pkg_share = get_package_share_directory(package_name)
    config_path = os.path.join(pkg_share, 'config', file_name)
    with open(config_path, 'r') as f:
        return yaml.safe_load(f)

def generate_launch_description():
    # Define paths
    ig_lio_share_dir = get_package_share_directory('ig_lio')
    rviz_config_file = os.path.join(ig_lio_share_dir, 'rviz', 'lio_show.rviz')
    param_file = os.path.join(ig_lio_share_dir, 'config', 'ouster.yaml')

    # Declare the ROS parameters file
    params = load_yaml('ig_lio', 'ouster.yaml')

    return LaunchDescription([
        # Load ROS parameters
        Node(
            package='ig_lio',
            executable='ig_lio_node',
            name='ig_lio_node',
            output='screen',
            parameters=[param_file]
        ),

        # Launch RViz
        Node(
            package='rviz2',
            executable='rviz2',
            name='rviz',
            arguments=['-d', rviz_config_file],
            output='screen'
        )
    ])
